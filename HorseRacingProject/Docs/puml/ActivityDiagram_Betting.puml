@startuml ActivityDiagram_Betting
skinparam Style strictuml

start

:Spectator chọn Race (status = BettingOpen);
:Chọn Registration (ngựa muốn cược);
:Chọn BetType (Win / Place / Show);
:Nhập BetAmount;

if (BetAmount <= 0?) then (yes)
  :Throw ArgumentException;
  stop
endif

if (Balance đủ?) then (no)
  :Throw lỗi số dư không đủ;
  stop
endif

:Trừ BetAmount khỏi Balance;
:Tạo Bet (Status = Active);
:Cộng BetAmount vào RacePool\ntheo BetType tương ứng;

stop

@enduml
