@startuml ActivityDiagram_Registration
skinparam Style strictuml

start

:HorseOwner chọn Race và Jockey;

if (Race status = Scheduled?) then (no)
  :Throw lỗi Race không nhận đăng ký;
  stop
endif

if (Ngựa status = Healthy?) then (no)
  :Throw lỗi ngựa không đủ điều kiện;
  stop
endif

if (Jockey bận race khác cùng khung giờ?) then (yes)
  :Throw lỗi xung đột lịch Jockey;
  stop
endif

if (Race đã đủ MaxParticipants?) then (yes)
  :Throw lỗi race đã đầy;
  stop
endif

:Trừ RegistrationFee khỏi Balance;
:Tạo Registration (Status = Pending);

fork
  :HorseOwner xác nhận\n(OwnerConfirmation = true);
fork again
  :Jockey xác nhận\n(JockeyConfirmation = true);
end fork

if (Cả hai đã xác nhận?) then (yes)
  :Registration Status → Confirmed;
else (no)
  :Chờ xác nhận;
endif

stop

@enduml
