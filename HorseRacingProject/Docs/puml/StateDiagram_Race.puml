@startuml StateDiagram_Race
skinparam Style strictuml

[*] --> Scheduled : Admin tạo Race

Scheduled --> BettingOpen : Admin mở cược
Scheduled --> Cancelled : Admin hủy

BettingOpen --> BettingClosed : Admin đóng cược
BettingOpen --> Cancelled : Admin hủy

BettingClosed --> Live : Admin bắt đầu đua
BettingClosed --> Cancelled : Admin hủy

Live --> Finished : Referee nộp kết quả

Finished --> Completed : Admin settle\n(phân phối thưởng)

Cancelled --> [*]
Completed --> [*]

@enduml
