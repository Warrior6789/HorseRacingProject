@startuml StateDiagram_Registration
skinparam Style strictuml

[*] --> Pending : HorseOwner đăng ký ngựa\n(trừ RegistrationFee)

Pending --> Confirmed : Owner + Jockey\nđều xác nhận
Pending --> Rejected : Admin từ chối\n(hoàn phí)

Confirmed --> Scratched : Rút khỏi cuộc đua

Confirmed --> [*] : Race diễn ra bình thường
Rejected --> [*]
Scratched --> [*]

@enduml
